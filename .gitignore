# 构建产物
/target/
**/*.rs.bk

# 验证脚本的临时输出
/target/verify-tmp/

# 本地覆盖（个人机器差异：镜像、插件目录等）
.env.local
.cargo/config.local.toml

# V8 预编译静态库：由 scripts/bootstrap.ps1 / bootstrap.sh 下载到本地，不入库
/vendor/rusty_v8/

# 编辑器
.idea/
.vscode/
*.swp

# 插件开发时常见的本地产物（示例插件的编译产物不入库）
plugins/*/dist/
plugins/*/node_modules/

# 运行时下载的第三方工具（Everything es.exe，不随仓库分发）
/tools/es/

# 本地打包/运行产物（安装包、临时打包文件、运行日志、IDE 与截图缓存）
/dist/
/*.exe
/*.zip
/*.log
/.tmp/
/.screenshots/
/.trae/
/.trae-html-share-packages/
.DS_Store
