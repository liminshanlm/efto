{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "efto",
  "version": "0.1.0",
  "identifier": "app.efto.launcher",
  "build": {
    "frontendDist": "../../frontend"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "efto",
        "url": "index.html",
        "create": false,
        "width": 520,
        "height": 320,
        "center": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false,
        "focus": false
      },
      {
        "label": "settings",
        "title": "efto 设置",
        "url": "settings.html",
        "create": false,
        "width": 960,
        "height": 640,
        "minWidth": 820,
        "minHeight": 520,
        "center": true,
        "resizable": true,
        "maximizable": false,
        "minimizable": true,
        "closable": true,
        "decorations": true,
        "visible": false,
        "skipTaskbar": false,
        "focus": false
      },
      {
        "label": "clipboard",
        "title": "efto 剪贴板",
        "url": "clipboard.html",
        "create": false,
        "width": 760,
        "height": 560,
        "minWidth": 520,
        "minHeight": 380,
        "center": true,
        "resizable": true,
        "maximizable": false,
        "minimizable": false,
        "closable": true,
        "decorations": true,
        "visible": false,
        "skipTaskbar": false,
        "focus": false
      },
      {
        "label": "help",
        "title": "efto 帮助",
        "url": "help.html",
        "create": false,
        "width": 920,
        "height": 680,
        "minWidth": 680,
        "minHeight": 460,
        "center": true,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "closable": true,
        "decorations": true,
        "visible": false,
        "skipTaskbar": false,
        "focus": false
      },
      {
        "label": "shortcuts",
        "title": "efto 快捷键指南",
        "url": "shortcuts.html",
        "create": false,
        "width": 760,
        "height": 620,
        "minWidth": 560,
        "minHeight": 420,
        "center": true,
        "resizable": true,
        "maximizable": true,
        "minimizable": false,
        "closable": true,
        "decorations": true,
        "visible": false,
        "skipTaskbar": false,
        "focus": false
      },
      {
        "label": "actions",
        "title": "efto 通用动作",
        "url": "actions.html",
        "create": false,
        "width": 680,
        "height": 520,
        "minWidth": 520,
        "minHeight": 360,
        "center": true,
        "resizable": true,
        "maximizable": false,
        "minimizable": false,
        "closable": true,
        "decorations": true,
        "visible": false,
        "skipTaskbar": false,
        "focus": false
      },
      {
        "label": "files",
        "title": "efto 文件缓冲",
        "url": "files.html",
        "create": false,
        "width": 720,
        "height": 560,
        "minWidth": 520,
        "minHeight": 380,
        "center": true,
        "resizable": true,
        "maximizable": false,
        "minimizable": false,
        "closable": true,
        "decorations": true,
        "visible": false,
        "skipTaskbar": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png"
    ]
  },
  "plugins": {}
}
